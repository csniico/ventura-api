# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/ventura

# Separate database used by integration tests (its collections are wiped each run)
MONGODB_TEST_URI=mongodb://localhost:27017/ventura_test

# HTTP server
SERVER_PORT=3000
ALLOWED_ORIGINS=*

# Auth (JWT)
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Google sign-in: the OAuth client id the frontend obtained the ID token with
GOOGLE_CLIENT_ID=

# AWS S3 (file storage / presigned uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-2
S3_BUCKET_NAME=
# How long a presigned upload URL stays valid (seconds)
S3_PRESIGN_EXPIRES=300

# Mail (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Ventura <nii@support.csniico.com>

# Live (real-send) mail spec. Both must be set to actually send test emails:
#   MAIL_LIVE_TEST=true MAIL_TEST_RECIPIENT=you@example.com pnpm jest mail.service.live.spec
MAIL_TEST_RECIPIENT=
MAIL_LIVE_TEST=
